{% extends "woo/base-light-product.twig" %}

{% block content %}
{% if brand_data %}
<div class="lk-lpt lk-lpt-container lk-tag-page lk-brand-page">
	{% if brand_data.breadcrumb_html %}
		<nav class="lk-lpt-breadcrumb" aria-label="breadcrumb">
			{{ brand_data.breadcrumb_html|raw }}
		</nav>
	{% endif %}

	<section class="lk-tag-hero" aria-label="{{ brand_data.name }}">
		<div class="lk-tag-hero__media">
			{% if brand_data.image %}
				<figure class="lk-tag-hero__photo">
					<img
						src="{{ brand_data.image.url }}"
						alt="{{ brand_data.image.alt|default(brand_data.name) }}"
						width="360"
						height="360"
						loading="eager"
					>
				</figure>
			{% else %}
				<div class="lk-tag-hero__placeholder" aria-hidden="true"></div>
			{% endif %}
		</div>
		<div class="lk-tag-hero__body">
			<p class="lk-tag-hero__eyebrow">برند</p>
			<h1 class="lk-tag-hero__title">
				<span class="lk-tag-hero__name">{{ brand_data.name }}</span>
				{% if brand_data.english_name %}
					<span class="lk-tag-hero__english">{{ brand_data.english_name }}</span>
				{% endif %}
			</h1>
			{% if brand_data.excerpt %}
				<div class="lk-tag-hero__desc">
					<p>{{ brand_data.excerpt }}</p>
					{% if brand_data.has_specs %}
						<button
							type="button"
							class="lk-tag-hero__more"
							data-lk-open-cat-tab="specs"
						>توضیحات بیشتر...</button>
					{% endif %}
				</div>
			{% elseif brand_data.has_specs %}
				<div class="lk-tag-hero__desc">
					<button
						type="button"
						class="lk-tag-hero__more"
						data-lk-open-cat-tab="specs"
					>توضیحات بیشتر...</button>
				</div>
			{% endif %}
		</div>
	</section>

	<section class="lk-cat-shell lk-brand-shell" aria-label="محتوای برند">
		<div class="lk-cat-tabs" role="tablist" aria-label="بخش‌های برند">
			<button
				type="button"
				class="lk-cat-tabs__btn is-active"
				id="lk-cat-tab-products"
				role="tab"
				aria-selected="true"
				aria-controls="lk-cat-panel-products"
				data-lk-cat-tab="products"
			>محصولات <span class="lk-cat-tabs__count">({{ brand_data.count }})</span></button>
			{% if brand_data.has_specs %}
				<button
					type="button"
					class="lk-cat-tabs__btn"
					id="lk-cat-tab-specs"
					role="tab"
					aria-selected="false"
					aria-controls="lk-cat-panel-specs"
					data-lk-cat-tab="specs"
				>مشخصات برند</button>
			{% endif %}
		</div>

		<div
			class="lk-cat-panel is-active"
			id="lk-cat-panel-products"
			role="tabpanel"
			aria-labelledby="lk-cat-tab-products"
			data-lk-cat-panel="products"
		>
			<div class="lk-lpt-shop">
				<aside class="lk-lpt-shop__filters" aria-label="فیلترها">
					{{ brand_data.filters_html|raw }}
				</aside>
				<div class="lk-lpt-shop__main">
					<div class="lk-lpt-shop__products">
						<div
							class="lk-archive-products__grid lk-shop-products-grid"
							id="lk-archive-products"
							role="list"
							data-lk-native-grid="1"
							style="--lk-lpt-cols: 4"
						>
							{{ brand_data.products_html|raw }}
						</div>
					</div>
					<nav class="lk-archive-products__pagination lk-shop-pagination" id="lk-archive-products-pagination" aria-label="صفحه‌بندی">
						{{ brand_data.pagination_html|raw }}
					</nav>
				</div>
			</div>
		</div>

		{% if brand_data.has_specs %}
			<div
				class="lk-cat-panel"
				id="lk-cat-panel-specs"
				role="tabpanel"
				aria-labelledby="lk-cat-tab-specs"
				data-lk-cat-panel="specs"
				hidden
			>
				<div class="lk-cat-specs">
					<aside class="lk-cat-toc" aria-label="فهرست مطالب">
						<div class="lk-cat-toc__head">
							<h2 class="lk-cat-toc__title">فهرست مطالب</h2>
						</div>
						<ol class="lk-cat-toc__list">
							{% for section in brand_data.sections %}
								<li class="lk-cat-toc__item{% if section.children %} has-children{% endif %}"{% if section.children %} data-lk-toc-group{% endif %}>
									<div class="lk-cat-toc__row">
										<a class="lk-cat-toc__btn" href="#{{ section.id }}" data-lk-cat-sec="{{ section.id }}">
											{{ section.label }}
										</a>
										{% if section.children %}
											<button
												type="button"
												class="lk-cat-toc__branch"
												aria-expanded="false"
												data-lk-toc-branch
												aria-label="{{ section.label }}"
											>
												<svg class="lk-cat-toc__chevron" viewBox="0 0 448 512" aria-hidden="true" focusable="false">
													<path fill="currentColor" d="M207.029 381.476L12.686 187.132c-9.373-9.373-9.373-24.569 0-33.941l22.667-22.667c9.357-9.357 24.522-9.375 33.901-.04L224 284.505l154.745-154.021c9.379-9.335 24.544-9.317 33.901.04l22.667 22.667c9.373 9.373 9.373 24.569 0 33.941L240.971 381.476c-9.373 9.372-24.569 9.372-33.942 0z"/>
												</svg>
											</button>
										{% endif %}
									</div>
									{% if section.children %}
										<ol class="lk-cat-toc__sub" data-lk-toc-sub hidden>
											{% for child in section.children %}
												<li class="lk-cat-toc__item">
													<a class="lk-cat-toc__btn lk-cat-toc__btn--sub" href="#{{ child.id }}" data-lk-cat-sec="{{ child.id }}">
														{{ child.label }}
													</a>
												</li>
											{% endfor %}
										</ol>
									{% endif %}
								</li>
							{% endfor %}
						</ol>
					</aside>

					<div class="lk-cat-article">
						<div class="lk-cat-article__frame">
							{% if brand_data.full_html %}
								{{ brand_data.full_html|raw }}
							{% else %}
								<p>توضیحی برای این برند ثبت نشده است.</p>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		{% endif %}
	</section>
</div>
{% endif %}
{% endblock %}
