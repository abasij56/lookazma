<!doctype html>
<!-- LK-LIGHT-PRODUCT-TWIG -->
<html {{ html_language_attributes|raw }}>
<head>
	<meta charset="{{ site.charset }}">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	{% if card_css_url %}
		<link rel="stylesheet" href="{{ card_css_url }}?v={{ card_css_ver }}">
	{% endif %}
	{% if light_css_url %}
		<link rel="stylesheet" href="{{ light_css_url }}?v={{ light_css_ver }}">
	{% endif %}
	{% if cat_css_url %}
		<link rel="stylesheet" href="{{ cat_css_url }}?v={{ cat_css_ver }}">
	{% endif %}
	{% if contact_css_url %}
		<link rel="stylesheet" href="{{ contact_css_url }}?v={{ contact_css_ver }}">
	{% endif %}
	{% if about_css_url %}
		<link rel="stylesheet" href="{{ about_css_url }}?v={{ about_css_ver }}">
	{% endif %}
	{% if account_css_url %}
		<link rel="stylesheet" href="{{ account_css_url }}?v={{ account_css_ver }}">
	{% endif %}
	{% if cart_page_css_url %}
		<link rel="stylesheet" href="{{ cart_page_css_url }}?v={{ cart_page_css_ver }}">
	{% endif %}
	{% if article_css_url %}
		<link rel="stylesheet" href="{{ article_css_url }}?v={{ article_css_ver }}">
	{% endif %}
	{% if homepage_css_url %}
		<link rel="stylesheet" href="{{ homepage_css_url }}?v={{ homepage_css_ver }}">
	{% endif %}
	{% if spl_css_url %}
		<link rel="stylesheet" href="{{ spl_css_url }}?v={{ spl_css_ver }}">
	{% endif %}
	{{ function('wp_head') }}
	<style id="lk-lpt-chrome-fix">
		html:has(body.lk-light-product){overflow-x:clip;transform:none!important}
		body.lk-light-product{overflow-x:clip;transform:none!important;padding-top:var(--lz-header-h)}
		body.lk-light-product > .lz-site-header,
		body.lk-light-product.search .lz-site-header,
		body.lk-light-product.search-results .lz-site-header{
			position:fixed!important;
			top:0!important;
			left:0!important;right:0!important;
			z-index:10050!important;width:100%!important;
			transform:none!important
		}
	</style>
</head>
<body class="{{ body_class }}">
{{ function('wp_body_open') }}

{% include 'partials/light-product-header.twig' %}

<main class="lk-lpt-main lk-main">
	{% block content %}{% endblock %}
</main>

{% include 'partials/light-product-footer.twig' %}

{{ function('wp_footer') }}
</body>
</html>
