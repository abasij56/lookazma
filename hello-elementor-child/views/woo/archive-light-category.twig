{% extends "woo/base-light-product.twig" %}

{% block content %}
{% if category_data %}
{% set is_mother = category_data.is_mother %}
<div class="lk-lpt lk-lpt-container lk-cat-page{% if is_mother %} lk-cat-page--mother{% else %} lk-cat-page--leaf{% endif %}">
	{% if category_data.breadcrumb_html %}
		<nav class="lk-lpt-breadcrumb" aria-label="breadcrumb">
			{{ category_data.breadcrumb_html|raw }}
		</nav>
	{% endif %}

	{% if is_mother %}
		<section class="lk-cat-mother-hero" aria-label="{{ category_data.name }}">
			<div class="lk-cat-mother-hero__copy">
				<h1 class="lk-cat-mother-hero__title">
					<span class="lk-cat-mother-hero__name">{{ category_data.name }}</span>
					{% if category_data.english_name %}
						<span class="lk-cat-mother-hero__english">{{ category_data.english_name }}</span>
					{% endif %}
				</h1>
				{% if category_data.mother_blurb %}
					<p class="lk-cat-mother-hero__blurb">{{ category_data.mother_blurb }}</p>
				{% endif %}
				{% if category_data.mother_trusts %}
					<ul class="lk-cat-mother-hero__trusts" aria-label="مزایای خرید">
						{% for trust in category_data.mother_trusts %}
							<li class="lk-cat-mother-hero__trust" data-lk-trust="{{ trust.key }}">
								<span class="lk-cat-mother-hero__trust-icon" aria-hidden="true">{{ trust.icon_html|raw }}</span>
								<span class="lk-cat-mother-hero__trust-label">{{ trust.label }}</span>
							</li>
						{% endfor %}
					</ul>
				{% endif %}
			</div>
			<div class="lk-cat-mother-hero__media">
				{% if category_data.images %}
					{% set image = category_data.images|first %}
					<figure class="lk-cat-mother-hero__photo">
						<img src="{{ image.url }}" alt="{{ image.alt|default(category_data.name) }}" width="720" height="480" loading="eager" decoding="async">
					</figure>
				{% else %}
					<div class="lk-cat-mother-hero__placeholder" aria-hidden="true"></div>
				{% endif %}
			</div>
		</section>
	{% else %}
		<section class="lk-cat-hero" aria-label="{{ category_data.name }}">
			<aside class="lk-cat-hero__media">
				<div class="lk-cat-hero__card">
					{% if category_data.images %}
						{% for image in category_data.images %}
							<figure class="lk-cat-hero__photo">
								<img src="{{ image.url }}" alt="{{ image.alt|default(category_data.name) }}" width="360" height="360" loading="eager">
							</figure>
						{% endfor %}
					{% else %}
						<div class="lk-cat-hero__placeholder" aria-hidden="true"></div>
					{% endif %}
					{% if category_data.hero_pills %}
						<ul class="lk-cat-hero__pills" aria-label="شناسه‌ها">
							{% for pill in category_data.hero_pills %}
								<li class="lk-cat-hero__pill" data-lk-fact="{{ pill.icon }}">
									{% if pill.icon == 'cas' %}
										<span class="lk-cat-hero__pill-label">CAS No</span>
									{% elseif pill.icon == 'formula' %}
										<span class="lk-cat-hero__pill-label">Formula</span>
									{% else %}
										<span class="lk-cat-hero__pill-label">{{ pill.label }}</span>
									{% endif %}
									<strong class="lk-cat-hero__pill-value">{{ pill.value }}</strong>
								</li>
							{% endfor %}
						</ul>
					{% endif %}
				</div>
				{% if category_data.msds_url %}
					<a class="lk-cat-hero__msds" href="{{ category_data.msds_url }}" target="_blank" rel="noopener noreferrer">
						<svg class="lk-cat-hero__msds-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
							<path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm1 7V3.5L18.5 9H15zM8 13h8v2H8v-2zm0 4h8v2H8v-2z"/>
						</svg>
						<span>دانلود MSDS</span>
					</a>
				{% endif %}
			</aside>
			<div class="lk-cat-hero__body">
				<h1 class="lk-cat-hero__title">
					<span class="lk-cat-hero__name">{{ category_data.name }}</span>
					{% if category_data.english_name %}
						<span class="lk-cat-hero__english">{{ category_data.english_name }}</span>
					{% endif %}
				</h1>
				{% if category_data.hero_synonym %}
					<div class="lk-cat-hero__synonyms" data-lk-fact="synonym">
						<span class="lk-cat-hero__synonyms-label">
							{% if category_data.hero_synonym.icon_html %}
								<span class="lk-cat-hero__fact-icon" aria-hidden="true">{{ category_data.hero_synonym.icon_html|raw }}</span>
							{% endif %}
							مترادف ها
						</span>
						<p class="lk-cat-hero__synonyms-value">{{ category_data.hero_synonym.value }}</p>
					</div>
				{% endif %}
				{% if category_data.hero_facts %}
					<ul class="lk-cat-article__facts" aria-label="مشخصات فنی">
						{% for item in category_data.hero_facts %}
							<li{% if item.wide %} class="lk-cat-article__facts-item--full"{% endif %}{% if item.icon %} data-lk-fact="{{ item.icon }}"{% endif %}>
								<span>
									{% if item.icon_html %}
										<span class="lk-cat-hero__fact-icon" aria-hidden="true">{{ item.icon_html|raw }}</span>
									{% endif %}
									{{ item.label }}
								</span>
								<strong>{{ item.value }}</strong>
							</li>
						{% endfor %}
					</ul>
				{% endif %}
			</div>
		</section>
	{% endif %}

	<section class="lk-cat-shell" aria-label="محتوای دسته">
		<div class="lk-cat-tabs" role="tablist" aria-label="بخش‌های دسته">
			<button
				type="button"
				class="lk-cat-tabs__btn is-active"
				id="lk-cat-tab-products"
				role="tab"
				aria-selected="true"
				aria-controls="lk-cat-panel-products"
				data-lk-cat-tab="products"
			>محصولات <span class="lk-cat-tabs__count">({{ category_data.count }})</span></button>
			{% if category_data.has_specs %}
				<button
					type="button"
					class="lk-cat-tabs__btn"
					id="lk-cat-tab-specs"
					role="tab"
					aria-selected="false"
					aria-controls="lk-cat-panel-specs"
					data-lk-cat-tab="specs"
				>مشخصات دسته بندی</button>
			{% endif %}
		</div>

		<div
			class="lk-cat-panel is-active"
			id="lk-cat-panel-products"
			role="tabpanel"
			aria-labelledby="lk-cat-tab-products"
			data-lk-cat-panel="products"
		>
			<div class="lk-lpt-shop">
				<aside class="lk-lpt-shop__filters" aria-label="فیلترها">
					{{ category_data.filters_html|raw }}
				</aside>
				<div class="lk-lpt-shop__main">
					<div class="lk-lpt-shop__products">
						<div
							class="lk-archive-products__grid lk-shop-products-grid"
							id="lk-archive-products"
							role="list"
							data-lk-native-grid="1"
							style="--lk-lpt-cols: 4"
						>
							{{ category_data.products_html|raw }}
						</div>
					</div>
					<nav class="lk-archive-products__pagination lk-shop-pagination" id="lk-archive-products-pagination" aria-label="صفحه‌بندی">
						{{ category_data.pagination_html|raw }}
					</nav>
				</div>
			</div>
		</div>

		{% if category_data.has_specs %}
			<div
				class="lk-cat-panel"
				id="lk-cat-panel-specs"
				role="tabpanel"
				aria-labelledby="lk-cat-tab-specs"
				data-lk-cat-panel="specs"
				hidden
			>
				<div class="lk-cat-specs">
					<aside class="lk-cat-toc" aria-label="فهرست مطالب">
						<div class="lk-cat-toc__head">
							<h2 class="lk-cat-toc__title">فهرست مطالب</h2>
						</div>
						<ol class="lk-cat-toc__list">
							{% for section in category_data.sections %}
								<li class="lk-cat-toc__item{% if section.children %} has-children{% endif %}"{% if section.children %} data-lk-toc-group{% endif %}>
									<div class="lk-cat-toc__row">
										<a class="lk-cat-toc__btn" href="#{{ section.id }}" data-lk-cat-sec="{{ section.id }}">
											{{ section.label }}
										</a>
										{% if section.children %}
											<button
												type="button"
												class="lk-cat-toc__branch"
												aria-expanded="false"
												data-lk-toc-branch
												aria-label="{{ section.label }}"
											>
												<svg class="lk-cat-toc__chevron" viewBox="0 0 448 512" aria-hidden="true" focusable="false">
													<path fill="currentColor" d="M207.029 381.476L12.686 187.132c-9.373-9.373-9.373-24.569 0-33.941l22.667-22.667c9.357-9.357 24.522-9.375 33.901-.04L224 284.505l154.745-154.021c9.379-9.335 24.544-9.317 33.901.04l22.667 22.667c9.373 9.373 9.373 24.569 0 33.941L240.971 381.476c-9.373 9.372-24.569 9.372-33.942 0z"/>
												</svg>
											</button>
										{% endif %}
									</div>
									{% if section.children %}
										<ol class="lk-cat-toc__sub" data-lk-toc-sub hidden>
											{% for child in section.children %}
												<li class="lk-cat-toc__item">
													<a class="lk-cat-toc__btn lk-cat-toc__btn--sub" href="#{{ child.id }}" data-lk-cat-sec="{{ child.id }}">
														{{ child.label }}
													</a>
												</li>
											{% endfor %}
										</ol>
									{% endif %}
								</li>
							{% endfor %}
						</ol>
					</aside>

					<div class="lk-cat-article">
						<div class="lk-cat-article__frame">
							{% if category_data.full_html %}
								{{ category_data.full_html|raw }}
							{% else %}
								<p>توضیحی برای این دسته ثبت نشده است.</p>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		{% endif %}
	</section>

	{% if is_mother and category_data.mother_stats %}
		<section class="lk-cat-stats" aria-label="مزایای لوک آزما">
			<div class="lk-cat-stats__inner">
				{% for stat in category_data.mother_stats %}
					<article class="lk-cat-stats__item" data-lk-stat="{{ stat.key }}">
						<span class="lk-cat-stats__icon" aria-hidden="true">{{ stat.icon_html|raw }}</span>
						<div class="lk-cat-stats__copy">
							<h2 class="lk-cat-stats__title">{{ stat.title }}</h2>
							<p class="lk-cat-stats__text">{{ stat.text }}</p>
						</div>
					</article>
				{% endfor %}
			</div>
		</section>
	{% endif %}
</div>
{% endif %}
{% endblock %}
