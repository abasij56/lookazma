{% extends "woo/base-light-product.twig" %}

{% block content %}
{% if category_data %}
<div class="lk-lpt lk-lpt-container lk-cat-page">
	{% if category_data.breadcrumb_html %}
		<nav class="lk-lpt-breadcrumb" aria-label="breadcrumb">
			{{ category_data.breadcrumb_html|raw }}
		</nav>
	{% endif %}

	<section class="lk-cat-hero" aria-label="{{ category_data.name }}">
		<div class="lk-cat-hero__media">
			{% if category_data.images %}
				{% for image in category_data.images %}
					<figure class="lk-cat-hero__photo">
						<img src="{{ image.url }}" alt="{{ image.alt|default(category_data.name) }}" width="360" height="360" loading="eager">
					</figure>
				{% endfor %}
			{% else %}
				<div class="lk-cat-hero__placeholder" aria-hidden="true"></div>
			{% endif %}
			{% if category_data.msds_url %}
				<a class="lk-cat-hero__msds" href="{{ category_data.msds_url }}" target="_blank" rel="noopener noreferrer">
					<svg class="lk-cat-hero__msds-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false">
						<path fill="currentColor" d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6zm1 7V3.5L18.5 9H15zM8 13h8v2H8v-2zm0 4h8v2H8v-2z"/>
					</svg>
					<span>MSDS</span>
				</a>
			{% endif %}
		</div>
		<div class="lk-cat-hero__body">
			<h1 class="lk-cat-hero__title">
				<span class="lk-cat-hero__name">{{ category_data.name }}</span>
				{% if category_data.english_name %}
					<span class="lk-cat-hero__english">{{ category_data.english_name }}</span>
				{% endif %}
			</h1>
			{% if category_data.specs %}
				<ul class="lk-cat-article__facts" aria-label="مشخصات فنی">
					{% for item in category_data.specs %}
						{% if item.value|trim|upper != 'N/A' %}
							<li{% if item.wide %} class="lk-cat-article__facts-item--full"{% endif %}{% if item.icon %} data-lk-fact="{{ item.icon }}"{% endif %}>
								<span>{{ item.label }}</span>
								<strong>{{ item.value }}</strong>
							</li>
						{% endif %}
					{% endfor %}
				</ul>
			{% endif %}
		</div>
	</section>

	<section class="lk-cat-shell" aria-label="محتوای دسته">
		<div class="lk-cat-tabs" role="tablist" aria-label="بخش‌های دسته">
			<button
				type="button"
				class="lk-cat-tabs__btn is-active"
				id="lk-cat-tab-products"
				role="tab"
				aria-selected="true"
				aria-controls="lk-cat-panel-products"
				data-lk-cat-tab="products"
			>محصولات <span class="lk-cat-tabs__count">({{ category_data.count }})</span></button>
			{% if category_data.has_specs %}
				<button
					type="button"
					class="lk-cat-tabs__btn"
					id="lk-cat-tab-specs"
					role="tab"
					aria-selected="false"
					aria-controls="lk-cat-panel-specs"
					data-lk-cat-tab="specs"
				>مشخصات دسته بندی</button>
			{% endif %}
		</div>

		<div
			class="lk-cat-panel is-active"
			id="lk-cat-panel-products"
			role="tabpanel"
			aria-labelledby="lk-cat-tab-products"
			data-lk-cat-panel="products"
		>
			<div class="lk-lpt-shop">
				<aside class="lk-lpt-shop__filters" aria-label="فیلترها">
					{{ category_data.filters_html|raw }}
				</aside>
				<div class="lk-lpt-shop__products">
					<div
						class="lk-archive-products__grid lk-shop-products-grid"
						id="lk-archive-products"
						role="list"
						data-lk-native-grid="1"
						style="--lk-lpt-cols: 4"
					>
						{{ category_data.products_html|raw }}
					</div>
					<nav class="lk-archive-products__pagination lk-shop-pagination" id="lk-archive-products-pagination" aria-label="صفحه‌بندی">
						{{ category_data.pagination_html|raw }}
					</nav>
				</div>
			</div>
		</div>

		{% if category_data.has_specs %}
			<div
				class="lk-cat-panel"
				id="lk-cat-panel-specs"
				role="tabpanel"
				aria-labelledby="lk-cat-tab-specs"
				data-lk-cat-panel="specs"
				hidden
			>
				<div class="lk-cat-specs">
					<aside class="lk-cat-toc" aria-label="فهرست مطالب">
						<div class="lk-cat-toc__head">
							<h2 class="lk-cat-toc__title">فهرست مطالب</h2>
						</div>
						<ol class="lk-cat-toc__list">
							{% for section in category_data.sections %}
								<li>
									<a class="lk-cat-toc__btn" href="#{{ section.id }}" data-lk-cat-sec="{{ section.id }}">
										{{ section.label }}
									</a>
								</li>
							{% endfor %}
						</ol>
					</aside>

					<div class="lk-cat-article">
						<div class="lk-cat-article__frame">
							{% if category_data.full_html %}
								{{ category_data.full_html|raw }}
							{% else %}
								<p>توضیحی برای این دسته ثبت نشده است.</p>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		{% endif %}
	</section>
</div>
{% endif %}
{% endblock %}
