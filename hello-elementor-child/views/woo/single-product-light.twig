{% extends "woo/base-light-product.twig" %}

{% block content %}
{% if product_data %}
<div class="lk-container">
	{% if product_data.breadcrumb_html %}
		<nav class="lk-lpt-breadcrumb lk-breadcrumb" aria-label="breadcrumb">
			{{ product_data.breadcrumb_html|raw }}
		</nav>
	{% endif %}
</div>

<article class="lk-product lk-container" data-product-id="{{ product_data.id }}" data-product-type="{{ product_data.is_variable ? 'variable' : 'simple' }}">
	{# RTL: [قیمت | مشخصات | عکس] — کارت محصول راست، کارت قیمت چپ #}
	<div class="lk-product__hero">
	<div class="lk-product__row">
		<section class="lk-info-card" aria-label="اطلاعات محصول">
			<div class="lk-info-card__inner">
				<div class="lk-info-card__media">
					{% if product_data.brand_image or product_data.brand_name %}
						{% if product_data.brand_link %}
							<a
								class="lk-product__brand-badge{% if product_data.brand_image %} lk-product__brand-badge--logo{% else %} lk-product__brand-badge--text{% endif %}"
								href="{{ product_data.brand_link }}"
								aria-label="{{ product_data.brand_name|default('برند') }}"
							>
								{% if product_data.brand_image %}
									<img src="{{ product_data.brand_image }}" alt="{{ product_data.brand_name|default('برند') }}" width="48" height="48">
								{% else %}
									<span>{{ product_data.brand_name }}</span>
								{% endif %}
							</a>
						{% else %}
							<span class="lk-product__brand-badge{% if product_data.brand_image %} lk-product__brand-badge--logo{% else %} lk-product__brand-badge--text{% endif %}">
								{% if product_data.brand_image %}
									<img src="{{ product_data.brand_image }}" alt="{{ product_data.brand_name|default('برند') }}" width="48" height="48">
								{% else %}
									<span>{{ product_data.brand_name }}</span>
								{% endif %}
							</span>
						{% endif %}
					{% endif %}

					<figure class="lk-info-card__photo">
						{% if product_data.image %}
							<img src="{{ product_data.image.url }}" alt="{{ product_data.image.alt|default(product_data.name) }}" width="800" height="576">
						{% else %}
							<span class="lk-info-card__placeholder">بدون تصویر</span>
						{% endif %}
					</figure>

					<div class="lk-info-card__tools" aria-label="ابزار محصول">
						<div class="lk-media-tool lk-media-tool--share" data-lk-share-root>
							<span
								class="lk-media-tool__btn"
								role="button"
								tabindex="0"
								aria-expanded="false"
								aria-haspopup="true"
								aria-label="اشتراک گذاری"
								data-lk-share-toggle
							>
								{% if product_data.share_icon_html %}
									{{ product_data.share_icon_html|raw }}
								{% endif %}
							</span>
							<div class="lk-media-tool__panel" data-lk-share-panel hidden role="menu">
								<button type="button" class="lk-media-tool__panel-item" data-lk-share-copy role="menuitem">
									{% if product_data.link_icon_html %}<span class="lk-media-tool__panel-icon" aria-hidden="true">{{ product_data.link_icon_html|raw }}</span>{% endif %}
									<span>کپی لینک</span>
								</button>
								{% if product_data.share_whatsapp_url %}
									<a class="lk-media-tool__panel-item" data-lk-share-wa href="{{ product_data.share_whatsapp_url }}" target="_blank" rel="noopener noreferrer" role="menuitem">
										<svg class="lk-media-tool__panel-icon" aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path fill="currentColor" d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.82c4.46 0 8.09 3.63 8.09 8.09 0 4.46-3.63 8.09-8.09 8.09-1.42 0-2.8-.37-4.01-1.07l-.29-.17-3.12.82.83-3.04-.19-.31a8.05 8.05 0 0 1-1.23-4.32c0-4.46 3.63-8.09 8.09-8.09zm4.58 10.56c-.25-.12-1.48-.73-1.71-.81-.23-.09-.4-.12-.56.12-.17.25-.64.81-.79.98-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74 1.78.77 2.35.83 3.19.7.51-.08 1.48-.6 1.69-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.17-.48-.29z"/></svg>
										<span>واتساپ</span>
									</a>
								{% endif %}
								{% if product_data.share_telegram_url %}
									<a class="lk-media-tool__panel-item" data-lk-share-tg href="{{ product_data.share_telegram_url }}" target="_blank" rel="noopener noreferrer" role="menuitem">
										{% if product_data.send_icon_html %}<span class="lk-media-tool__panel-icon" aria-hidden="true">{{ product_data.send_icon_html|raw }}</span>{% endif %}
										<span>تلگرام</span>
									</a>
								{% endif %}
							</div>
						</div>

						<div class="lk-media-tool lk-media-tool--compare">
							<button
								type="button"
								class="lk-media-tool__btn"
								data-lk-compare-from-single="{{ product_data.id }}"
								{% if product_data.is_variable %}data-lk-compare-variable="1"{% endif %}
								aria-label="مقایسه محصول"
							>
								{% if product_data.compare_icon_html %}
									{{ product_data.compare_icon_html|raw }}
								{% endif %}
							</button>
							<span class="lk-media-tool__tip" aria-hidden="true">مقایسه محصول</span>
						</div>
					</div>

					{% if product_data.brand_name %}
						{% if product_data.brand_link %}
							<a class="lk-info-card__brand-btn" href="{{ product_data.brand_link }}">
								محصولات دیگر {{ product_data.brand_name }}
							</a>
						{% else %}
							<span class="lk-info-card__brand-btn lk-info-card__brand-btn--static">
								محصولات دیگر {{ product_data.brand_name }}
							</span>
						{% endif %}
					{% endif %}
				</div>

				<div class="lk-info-card__body">
					<h1 class="lk-info-card__title">
						<span class="lk-info-card__name">{{ product_data.name }}</span>
						{% if product_data.english_name %}
							<span class="lk-info-card__english">{{ product_data.english_name }}</span>
						{% endif %}
					</h1>

					{% if product_data.cas_no %}
						<div class="lk-info-card__meta">
							<p class="lk-info-card__cas" dir="ltr">
								<span class="lk-info-card__cas-label">CAS:</span>
								<span class="lk-info-card__cas-value">{{ product_data.cas_no }}</span>
							</p>
						</div>
					{% endif %}

					<hr class="lk-info-card__divider">

					{% if product_data.highlights or product_data.datasheet_view_url or product_data.datasheet %}
						<div class="lk-info-card__specs">
							{% if product_data.highlights %}
								<h2>مشخصات محصول</h2>
								<table class="lk-table lk-specs-table">
									<tbody>
										{% for item in product_data.highlights %}
											<tr{% if item.icon %} data-lk-fact="{{ item.icon }}"{% endif %}>
												<th scope="row">
													{% if item.icon_html %}
														<span class="lk-specs-table__icon" aria-hidden="true">{{ item.icon_html|raw }}</span>
													{% endif %}
													{{ item.label }}
												</th>
												<td>{{ item.value }}</td>
											</tr>
										{% endfor %}
									</tbody>
								</table>
							{% endif %}
							{% if product_data.datasheet_view_url or product_data.datasheet %}
								<div class="lk-specs-table__datasheet">
									<button
										type="button"
										class="lk-datasheet"
										data-lk-datasheet-open
										data-view-url="{{ product_data.datasheet_view_url|e }}"
										data-download-url="{{ product_data.datasheet_download_url|e }}"
										data-fallback-url="{{ product_data.datasheet|e }}"
										data-mime="{{ product_data.datasheet_mime|e }}"
										data-share-url="{{ product_data.permalink|e }}"
										data-share-title="{{ product_data.name|e }}"
									>
										{% if product_data.datasheet_icon_html %}
											<span class="lk-datasheet__icon" aria-hidden="true">{{ product_data.datasheet_icon_html|raw }}</span>
										{% endif %}
										دانلود برگه مشخصات فنی
									</button>
								</div>
							{% endif %}
						</div>
					{% endif %}
				</div>
			</div>
		</section>

		<aside class="lk-price-card" aria-label="خرید محصول">
			<p class="lk-compare__toast lk-price-card__compare-toast" data-lk-compare-toast hidden role="status" aria-live="polite"></p>
			{% if product_data.price_notice %}
				<p class="lk-price-card__notice">{{ product_data.price_notice }}</p>
			{% endif %}

			<div class="lk-price-card__head">
				<p class="lk-price-card__label">قیمت محصول</p>
				<div class="lk-price-card__amount" data-lk-price-amount>{{ product_data.price_html|raw }}</div>

				{% if product_data.is_in_stock %}
					<div class="lk-price-card__stock is-in">موجود در انبار</div>
				{% else %}
					<div class="lk-price-card__stock is-muted">ناموجود</div>
				{% endif %}
			</div>

			<div class="lk-price-card__cart">
				{{ product_data.add_to_cart_html|raw }}
			</div>

			{% if product_data.whatsapp_url %}
				<a class="lk-price-card__whatsapp lk-price-card__whatsapp--inquiry" href="{{ product_data.whatsapp_url }}" target="_blank" rel="noopener noreferrer">
					<svg aria-hidden="true" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
					<span>استعلام قیمت</span>
				</a>
			{% endif %}

			{% if product_data.shipping_url %}
				<a class="lk-price-card__shipping-row" href="{{ product_data.shipping_url }}">
					{% if product_data.truck_icon_html %}
						<span class="lk-price-card__shipping-icon" aria-hidden="true">{{ product_data.truck_icon_html|raw }}</span>
					{% endif %}
					<span>روش و هزینه ارسال کالا</span>
				</a>
			{% endif %}
		</aside>
	</div>
	</div>

	<ul class="lk-badges" aria-label="مزایای خرید">
		{% for badge in product_data.badges %}
			<li>
				{% if badge.icon_html %}
					<span class="lk-badges__icon" aria-hidden="true">{{ badge.icon_html|raw }}</span>
				{% endif %}
				<span>{{ badge.label }}</span>
			</li>
		{% endfor %}
	</ul>

	<section class="lk-tabs" data-lk-tabs>
		<div class="lk-cat-tabs lk-tabs__nav" role="tablist" aria-label="بخش‌های محصول">
			<button type="button" class="lk-cat-tabs__btn is-active" data-tab="attrs" role="tab" aria-selected="true">مشخصات محصول</button>
			<button type="button" class="lk-cat-tabs__btn" data-tab="intro" role="tab" aria-selected="false">معرفی محصول</button>
			<button type="button" class="lk-cat-tabs__btn" data-tab="reviews" role="tab" aria-selected="false">نظرات</button>
		</div>

		<div class="lk-tabs__panel lk-cat-panel is-active" data-panel="attrs" role="tabpanel">
			{% if product_data.attributes %}
				<table class="lk-table">
					<tbody>
						{% for attr in product_data.attributes %}
							<tr>
								<th>{{ attr.label }}</th>
								<td>{{ attr.value }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			{% else %}
				<p>مشخصاتی ثبت نشده است.</p>
			{% endif %}
		</div>

		<div class="lk-tabs__panel lk-cat-panel" data-panel="intro" role="tabpanel" hidden>
			{% if product_data.description %}
				<div class="lk-prose">
					{{ product_data.description|raw }}
				</div>
			{% else %}
				<p>توضیحی برای این محصول ثبت نشده است.</p>
			{% endif %}
		</div>

		<div class="lk-tabs__panel lk-cat-panel" data-panel="reviews" role="tabpanel" hidden>
			{% if product_data.reviews_html %}
				{{ product_data.reviews_html|raw }}
			{% else %}
				<div class="lk-reviews lk-reviews--empty">
					<p class="lk-reviews__empty">هنوز نظری ثبت نشده است.</p>
				</div>
			{% endif %}
		</div>
	</section>

	{% if product_data.related_html %}
		<section class="lk-related" aria-labelledby="lk-related-title">
			<h2 id="lk-related-title">محصولات مرتبط</h2>
			<div class="lk-related__grid lk-shop-products-grid" role="list">
				{{ product_data.related_html|raw }}
			</div>
		</section>
	{% endif %}
</article>

{% if product_data.datasheet_view_url or product_data.datasheet %}
<div class="lk-ds-viewer" id="lk-ds-viewer" hidden aria-hidden="true">
	<div class="lk-ds-viewer__backdrop" data-lk-datasheet-close tabindex="-1"></div>
	<div class="lk-ds-viewer__dialog" role="dialog" aria-modal="true" aria-label="برگه مشخصات فنی" data-lk-datasheet-dialog>
		<div class="lk-ds-viewer__toolbar" role="toolbar" aria-label="ابزار برگه مشخصات">
			<button type="button" class="lk-ds-viewer__btn" data-lk-datasheet-close aria-label="بستن">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18.3 5.71 12 12l6.3 6.29-1.41 1.42L10.59 13.4 4.3 19.71 2.89 18.3 9.17 12 2.89 5.71 4.3 4.29l6.29 6.3 6.29-6.3z"/></svg>
			</button>
			<div class="lk-ds-viewer__share">
				<button type="button" class="lk-ds-viewer__btn" data-lk-datasheet-share-toggle aria-expanded="false" aria-haspopup="true" aria-label="اشتراک‌گذاری">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92-1.31-2.92-2.92-2.92z"/></svg>
				</button>
				<div class="lk-ds-viewer__share-menu" data-lk-datasheet-share-menu hidden role="menu">
					<a class="lk-ds-viewer__share-item" data-lk-share="whatsapp" role="menuitem" target="_blank" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2zm0 1.82c4.46 0 8.09 3.63 8.09 8.09 0 4.46-3.63 8.09-8.09 8.09-1.42 0-2.8-.37-4.01-1.07l-.29-.17-3.12.82.83-3.04-.19-.31a8.05 8.05 0 0 1-1.23-4.32c0-4.46 3.63-8.09 8.09-8.09zm4.58 10.56c-.25-.12-1.48-.73-1.71-.81-.23-.09-.4-.12-.56.12-.17.25-.64.81-.79.98-.14.17-.29.19-.54.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.24-1.47-1.39-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.41-.42-.56-.42h-.48c-.17 0-.43.06-.66.31-.22.25-.86.85-.86 2.07 0 1.22.89 2.4 1.01 2.56.12.17 1.75 2.67 4.23 3.74 1.78.77 2.35.83 3.19.7.51-.08 1.48-.6 1.69-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.17-.48-.29z"/></svg>
						<span>اشتراک در واتساپ</span>
					</a>
					<a class="lk-ds-viewer__share-item" data-lk-share="telegram" role="menuitem" target="_blank" rel="noopener noreferrer">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M9.78 15.35 9.6 18.1c.27 0 .39-.12.54-.26l1.3-1.25 2.7 1.98c.49.27.85.13 1-.46l1.8-8.48c.16-.73-.26-1.02-.74-.84L5.3 11.2c-.7.27-.69.66-.12.84l2.9.91 6.74-4.24c.32-.2.61-.09.37.12z"/></svg>
						<span>اشتراک در تلگرام</span>
					</a>
				</div>
			</div>
			<a class="lk-ds-viewer__btn" data-lk-datasheet-download href="#" download aria-label="دانلود">
				<svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M5 20h14v-2H5v2zm7-18L5.33 9h3.84v6h5.66V9h3.84L12 2z"/></svg>
			</a>
			<button type="button" class="lk-ds-viewer__btn" data-lk-datasheet-fullscreen aria-pressed="false" aria-label="بزرگ‌نمایی برگه">
				<svg class="lk-ds-viewer__icon-fs" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/></svg>
				<svg class="lk-ds-viewer__icon-fs-exit" viewBox="0 0 24 24" aria-hidden="true" hidden><path fill="currentColor" d="M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z"/></svg>
			</button>
		</div>
		<div class="lk-ds-viewer__stage" data-lk-datasheet-stage></div>
	</div>
</div>
{% endif %}

{% else %}
	<div class="lk-container">
		<p>محصول پیدا نشد.</p>
	</div>
{% endif %}
{% endblock %}
