<header class="lz-site-header" data-source="lookazma-header-native">
	<div class="lz-site-header__top">
		{% if logo_html %}
			<div class="lz-site-header__logo">{{ logo_html|raw }}</div>
		{% else %}
			<a class="lz-site-header__logo" href="{{ home_url }}">
				<img src="https://lookazma.com/wp-content/uploads/2023/06/lookazma-logo-1.svg" width="248" height="36" alt="{{ site_name }}">
			</a>
		{% endif %}

		<div class="lz-search lz-search--desktop">
			{{ search_desktop|raw }}
		</div>

		<div class="lz-header-actions">
			{% if account_logged_in %}
			<details class="lz-account-menu">
				<summary class="lz-account-menu__summary" aria-label="حساب کاربری">
					<span class="lz-account-menu__name">{{ account_display_name }}</span>
					<span class="lz-account-btn lz-account-btn--icon">
						<span class="lz-account-btn__icon" aria-hidden="true">
							<svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M256 288c79.5 0 144-64.5 144-144S335.5 0 256 0 112 64.5 112 144s64.5 144 144 144zm128 32h-55.1c-22.2 10.2-46.9 16-72.9 16s-50.6-5.8-72.9-16H128C57.3 320 0 377.3 0 448v16c0 26.5 21.5 48 48 48h416c26.5 0 48-21.5 48-48v-16c0-70.7-57.3-128-128-128z"></path></svg>
						</span>
					</span>
				</summary>
				<div class="lz-account-menu__panel">
					<a class="lz-account-menu__link" href="{{ account_url }}">داشبورد</a>
					<a class="lz-account-menu__link lz-account-menu__link--logout" href="{{ logout_url }}">خروج</a>
				</div>
			</details>
			{% else %}
			<a class="lz-account-btn" href="{{ login_url }}" aria-label="ورود/عضویت">
				<span class="lz-account-btn__icon" aria-hidden="true">
					<svg viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path d="M256 288c79.5 0 144-64.5 144-144S335.5 0 256 0 112 64.5 112 144s64.5 144 144 144zm128 32h-55.1c-22.2 10.2-46.9 16-72.9 16s-50.6-5.8-72.9-16H128C57.3 320 0 377.3 0 448v16c0 26.5 21.5 48 48 48h416c26.5 0 48-21.5 48-48v-16c0-70.7-57.3-128-128-128z"></path></svg>
				</span>
				<span class="lz-account-btn__text">ورود/عضویت</span>
			</a>
			{% endif %}
			<a class="lz-cart-btn" href="{{ cart_url }}" aria-label="سبد خرید">
				<span class="lz-cart-btn__price">{{ cart_total }}</span>
				<span class="lz-cart-btn__icon">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6A6 6 0 0 0 6 6H0v15a3 3 0 0 0 3 3h11v-2H3a1 1 0 0 1-1-1V8h4v2h2V8h8v2h2V8h4v6h2V6zm-10 0a4 4 0 0 1 8 0z"/><path d="M21 16h-2v3h-3v2h3v3h2v-3h3v-2h-3z"/></svg>
					<span class="lz-cart-btn__count cart-contents-count">{{ cart_count }}</span>
				</span>
			</a>
			<button type="button" class="lz-menu-toggle" aria-label="منو" aria-controls="lz-nav-panel" aria-expanded="false">
				<svg class="lz-menu-toggle__icon lz-menu-toggle__icon--open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
					<path fill="currentColor" d="M3 6h18v2H3V6zm0 5h18v2H3v-2zm0 5h18v2H3v-2z"/>
				</svg>
				<svg class="lz-menu-toggle__icon lz-menu-toggle__icon--close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
					<path fill="currentColor" d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
				</svg>
			</button>
		</div>
	</div>

	<div class="lz-search-mobile">
		<div class="lz-search">
			{{ search_mobile|raw }}
		</div>
	</div>

	<div class="lz-nav-backdrop" aria-hidden="true"></div>

	<div class="lz-site-header__bottom" id="lz-nav-panel">
		<nav class="lz-nav" aria-label="منوی اصلی">
			{% if header_menu %}
				{{ header_menu|raw }}
			{% else %}
				<a href="{{ home_url }}فروشگاه/">فروشگاه</a>
				<a href="{{ home_url }}about-us/">درباره ما</a>
				<a href="{{ home_url }}contact-us/">تماس با ما</a>
				<a href="{{ home_url }}article/">مجله لوک آزما</a>
				<a href="{{ home_url }}my-account/">حساب کاربری</a>
			{% endif %}
		</nav>
		<div class="lz-phones">
			<a class="lz-phones__link" href="tel:02182802125">
				<svg class="lz-phones__icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8z"/></svg>
				<span>02182802125</span>
			</a>
			<a class="lz-phones__link" href="tel:09122114322">
				<svg class="lz-phones__icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1.1-.3 1.2.4 2.5.6 3.8.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1C10.6 21 3 13.4 3 4c0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.3.2 2.6.6 3.8.1.4 0 .8-.3 1.1L6.6 10.8z"/></svg>
				<span>09122114322</span>
			</a>
		</div>
	</div>
	<script>
	(function () {
		var btn = document.querySelector('.lz-menu-toggle');
		var panel = document.getElementById('lz-nav-panel');
		var backdrop = document.querySelector('.lz-nav-backdrop');
		var header = document.querySelector('.lz-site-header');
		function syncHeaderOffset() {
			if (!header) return;
			var height = Math.round(header.getBoundingClientRect().height);
			if (height < 48) return;
			document.documentElement.style.setProperty('--lz-header-offset', '0px');
			document.documentElement.style.setProperty('--lz-header-h', height + 'px');
		}
		syncHeaderOffset();
		document.addEventListener('click', function (e) {
			document.querySelectorAll('.lz-account-menu[open]').forEach(function (menu) {
				if (!menu.contains(e.target)) menu.removeAttribute('open');
			});
		});
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape') {
				document.querySelectorAll('.lz-account-menu[open]').forEach(function (menu) {
					menu.removeAttribute('open');
				});
			}
		});
		if (!btn || !panel) return;
		function setOpen(open) {
			document.body.classList.toggle('lz-nav-open', open);
			btn.setAttribute('aria-expanded', open ? 'true' : 'false');
			panel.setAttribute('aria-hidden', open ? 'false' : 'true');
			document.body.style.overflow = open ? 'hidden' : '';
			window.requestAnimationFrame(syncHeaderOffset);
		}
		btn.addEventListener('click', function () {
			setOpen(!document.body.classList.contains('lz-nav-open'));
		});
		if (backdrop) backdrop.addEventListener('click', function () { setOpen(false); });
		document.addEventListener('keydown', function (e) {
			if (e.key === 'Escape') setOpen(false);
		});
		panel.addEventListener('click', function (e) {
			if (e.target.closest('a') && window.matchMedia('(max-width: 899px)').matches) setOpen(false);
		});
		window.addEventListener('resize', function () {
			if (window.matchMedia('(min-width: 900px)').matches) setOpen(false);
			syncHeaderOffset();
		});
	})();
	</script>
</header>
