{% for post in article.posts %}
<div class="lk-article-card-wrap" role="listitem">
	<article class="lk-article-card">
		<a class="lk-article-card__media" href="{{ post.url }}">
			{% if post.image %}
				<img src="{{ post.image }}" alt="{{ post.title }}" loading="lazy" width="600" height="173">
			{% endif %}
		</a>
		<div class="lk-article-card__body">
			<p class="lk-article-card__date">
				{% if article.date_icon_html %}
					{{ article.date_icon_html|raw }}
				{% endif %}
				<span>{{ post.date }}</span>
			</p>
			<h2 class="lk-article-card__title"><a href="{{ post.url }}">{{ post.title }}</a></h2>
			<a class="lk-article-card__more" href="{{ post.url }}">{{ article.more_label }}</a>
		</div>
	</article>
</div>
{% endfor %}
