{% extends "woo/base-light-product.twig" %}

{% block content %}
<div class="lk-lpt lk-lpt-container lk-compare-page">
	{% if compare.breadcrumb_html %}
		<nav class="lk-lpt-breadcrumb" aria-label="breadcrumb">
			{{ compare.breadcrumb_html|raw }}
		</nav>
	{% endif %}

	<section class="lk-compare-hero lk-glass-card" aria-label="{{ compare.title }}">
		<h1 class="lk-compare-hero__title">{{ compare.title }}</h1>
	</section>

	<div class="lk-compare" data-lk-compare-root>
		<p class="lk-compare__toast" data-lk-compare-toast hidden role="status" aria-live="polite"></p>
		<p class="lk-compare__notice" data-lk-compare-notice hidden></p>

		<div class="lk-compare__board" data-lk-compare-board>
			<div class="lk-compare__board-loading" data-lk-compare-board-loading hidden aria-hidden="true">
				<span class="lk-compare__board-spinner" aria-hidden="true"></span>
				<span class="lk-compare__board-loading-text">در حال بارگذاری</span>
			</div>
			<div class="lk-compare__grid" data-lk-compare-grid></div>

			<div class="lk-compare-specs" data-lk-compare-specs hidden></div>
		</div>

		<div class="lk-compare-modal" data-lk-compare-modal hidden aria-hidden="true">
			<div class="lk-compare-modal__backdrop" data-lk-compare-modal-close tabindex="-1" aria-hidden="true"></div>
			<div
				class="lk-compare-modal__panel lk-glass-card"
				role="dialog"
				aria-modal="true"
				aria-labelledby="lk-compare-modal-title"
			>
				<div class="lk-compare-modal__head">
					<h2 class="lk-compare-modal__title" id="lk-compare-modal-title">افزودن محصول</h2>
					<button type="button" class="lk-compare-modal__close" data-lk-compare-modal-close aria-label="بستن">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" focusable="false">
							<path fill="currentColor" d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
						</svg>
					</button>
				</div>
				<div class="lk-compare-picker" data-lk-compare-picker>
					<label class="lk-compare-picker__field" for="lk-compare-search-input">
						<span class="lk-compare-picker__icon" aria-hidden="true">
							<svg class="lk-compare-picker__icon-search" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" focusable="false">
								<path fill="currentColor" d="M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
							</svg>
							<svg class="lk-compare-picker__icon-loading" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" focusable="false">
								<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="40 60"/>
							</svg>
						</span>
						<input
							id="lk-compare-search-input"
							class="lk-compare-picker__input"
							type="search"
							name="lk_compare_q"
							autocomplete="off"
							placeholder="جستجوی محصول…"
							data-lk-compare-search
						/>
					</label>
					<div class="lk-compare-picker__panel">
						<p class="lk-compare-picker__section-title" data-lk-compare-section-title>محصولات</p>
						<div class="lk-compare-picker__scroll" data-lk-compare-results role="listbox" aria-label="نتایج جستجو"></div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
{% endblock %}
