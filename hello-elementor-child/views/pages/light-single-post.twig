{% extends "woo/base-light-product.twig" %}

{% block content %}
{% if single_post %}
<div class="lk-lpt lk-lpt-container lk-single-post">
	{% if single_post.breadcrumb_html %}
		<nav class="lk-lpt-breadcrumb" aria-label="breadcrumb">
			{{ single_post.breadcrumb_html|raw }}
		</nav>
	{% endif %}

	<div class="lk-single-post__layout">
		<article class="lk-single-post__main" itemscope itemtype="https://schema.org/Article">
			<ul class="lk-single-post__meta">
				{% if single_post.author_name %}
					<li class="lk-single-post__meta-item">
						{% if single_post.author_url %}
							<a href="{{ single_post.author_url }}" rel="author">
								<svg class="lk-single-post__meta-icon" viewBox="0 0 496 512" aria-hidden="true"><path fill="currentColor" d="M248 104c-53 0-96 43-96 96s43 96 96 96 96-43 96-96-43-96-96-96zm0 144c-26.5 0-48-21.5-48-48s21.5-48 48-48 48 21.5 48 48-21.5 48-48 48zm0-240C111 8 0 119 0 256s111 248 248 248 248-111 248-248S385 8 248 8zm0 448c-49.7 0-95.1-18.3-130.1-48.4 14.9-23 40.4-38.6 69.6-39.5 20.8 6.4 40.6 9.6 60.5 9.6s39.7-3.1 60.5-9.6c29.2 1 54.7 16.5 69.6 39.5-35 30.1-80.4 48.4-130.1 48.4zm162.7-84.1c-24.4-31.4-62.1-51.9-105.1-51.9-10.2 0-26 9.6-57.6 9.6-31.5 0-47.4-9.6-57.6-9.6-42.9 0-80.6 20.5-105.1 51.9C61.9 339.2 48 299.2 48 256c0-110.3 89.7-200 200-200s200 89.7 200 200c0 43.2-13.9 83.2-37.3 115.9z"/></svg>
								<span itemprop="author">{{ single_post.author_name }}</span>
							</a>
						{% else %}
							<span itemprop="author">{{ single_post.author_name }}</span>
						{% endif %}
					</li>
				{% endif %}
				{% if single_post.time %}
					<li class="lk-single-post__meta-item">
						<svg class="lk-single-post__meta-icon" viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M256 8C119 8 8 119 8 256s111 248 248 248 248-111 248-248S393 8 256 8zm0 448c-110.5 0-200-89.5-200-200S145.5 56 256 56s200 89.5 200 200-89.5 200-200 200zm61.8-104.4l-84.9-61.7c-3.1-2.3-4.9-5.9-4.9-9.7V116c0-6.6 5.4-12 12-12h32c6.6 0 12 5.4 12 12v141.7l66.8 48.6c5.4 3.9 6.5 11.4 2.6 16.8L334.6 349c-3.9 5.3-11.4 6.5-16.8 2.6z"/></svg>
						<time>{{ single_post.time }}</time>
					</li>
				{% endif %}
				{% if single_post.categories %}
					<li class="lk-single-post__meta-item lk-single-post__meta-item--terms">
						<svg class="lk-single-post__meta-icon" viewBox="0 0 640 512" aria-hidden="true"><path fill="currentColor" d="M497.941 225.941L286.059 14.059A48 48 0 0 0 252.118 0H48C21.49 0 0 21.49 0 48v204.118a48 48 0 0 0 14.059 33.941l211.882 211.882c18.744 18.745 49.136 18.746 67.882 0l204.118-204.118c18.745-18.745 18.745-49.137 0-67.882zM112 160c-26.51 0-48-21.49-48-48s21.49-48 48-48 48 21.49 48 48-21.49 48-48 48zm513.941 133.823L421.823 497.941c-18.745 18.745-49.137 18.745-67.882 0l-.36-.36L527.64 323.522c16.999-16.999 26.36-39.6 26.36-63.64s-9.362-46.641-26.36-63.64L331.397 0h48.721a48 48 0 0 1 33.941 14.059l211.882 211.882c18.745 18.745 18.745 49.137 0 67.882z"/></svg>
						<span class="lk-single-post__terms">
							{% for cat in single_post.categories %}
								<a href="{{ cat.url }}">{{ cat.name }}</a>{% if not loop.last %}، {% endif %}
							{% endfor %}
						</span>
					</li>
				{% endif %}
			</ul>

			{% if single_post.image %}
				<figure class="lk-single-post__featured">
					<img src="{{ single_post.image.url }}" alt="{{ single_post.image.alt }}" width="600" height="300" loading="eager" decoding="async" itemprop="image">
				</figure>
			{% endif %}

			{% if single_post.toc %}
				<nav class="lk-post-toc" data-lk-post-toc aria-label="{{ single_post.toc_title }}">
					<button type="button" class="lk-post-toc__header" aria-expanded="true" aria-controls="lk-post-toc-body" data-lk-post-toc-toggle>
						<span class="lk-post-toc__title">{{ single_post.toc_title }}</span>
						<span class="lk-post-toc__toggle" aria-hidden="true">
							<svg class="lk-post-toc__chevron" viewBox="0 0 448 512"><path fill="currentColor" d="M207.029 381.476L12.686 187.132c-9.373-9.373-9.373-24.569 0-33.941l22.667-22.667c9.357-9.357 24.522-9.375 33.901-.04L224 284.505l154.745-154.021c9.379-9.335 24.544-9.317 33.901.04l22.667 22.667c9.373 9.373 9.373 24.569 0 33.941L240.971 381.476c-9.373 9.372-24.569 9.372-33.942 0z"/></svg>
						</span>
					</button>
					<div class="lk-post-toc__body" id="lk-post-toc-body" data-lk-post-toc-body>
						<ol class="lk-post-toc__list">
							{% for item in single_post.toc %}
								<li class="lk-post-toc__item lk-post-toc__item--h{{ item.level }}{% if item.children %} has-children{% endif %}" {% if item.children %}data-lk-toc-group{% endif %}>
									<div class="lk-post-toc__row">
										<a class="lk-post-toc__link" href="#{{ item.id }}">{{ item.label }}</a>
										{% if item.children %}
											<button type="button" class="lk-post-toc__branch" aria-expanded="false" data-lk-toc-branch aria-label="{{ item.label }}">
												<svg class="lk-post-toc__chevron" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M207.029 381.476L12.686 187.132c-9.373-9.373-9.373-24.569 0-33.941l22.667-22.667c9.357-9.357 24.522-9.375 33.901-.04L224 284.505l154.745-154.021c9.379-9.335 24.544-9.317 33.901.04l22.667 22.667c9.373 9.373 9.373 24.569 0 33.941L240.971 381.476c-9.373 9.372-24.569 9.372-33.942 0z"/></svg>
											</button>
										{% endif %}
									</div>
									{% if item.children %}
										<ol class="lk-post-toc__sub" data-lk-toc-sub hidden>
											{% for child in item.children %}
												<li class="lk-post-toc__item lk-post-toc__item--h{{ child.level }}">
													<a class="lk-post-toc__link" href="#{{ child.id }}">{{ child.label }}</a>
												</li>
											{% endfor %}
										</ol>
									{% endif %}
								</li>
							{% endfor %}
						</ol>
					</div>
				</nav>
			{% endif %}

			<div class="lk-single-post__article">
				<h1 class="lk-single-post__title" itemprop="headline">{{ single_post.title }}</h1>
				<div class="lk-single-post__content" itemprop="articleBody">
					{{ single_post.content|raw }}
				</div>
			</div>

			<aside class="lk-single-post__cta" aria-label="تماس">
				<p class="lk-single-post__cta-text">{{ single_post.cta_text }}</p>
				<a class="lk-single-post__cta-phone" href="{{ single_post.cta_phone_href }}" rel="nofollow">
					<svg viewBox="0 0 512 512" aria-hidden="true"><path fill="currentColor" d="M497.39 361.8l-112-48a24 24 0 0 0-28 6.9l-49.6 60.6A370.66 370.66 0 0 1 130.6 204.11l60.6-49.6a23.94 23.94 0 0 0 6.9-28l-48-112A24.16 24.16 0 0 0 122.6.61l-104 24A24 24 0 0 0 0 48c0 256.5 207.9 464 464 464a24 24 0 0 0 23.4-18.6l24-104a24.29 24.29 0 0 0-14.01-27.6z"/></svg>
					<span>{{ single_post.cta_phone }}</span>
				</a>
			</aside>
		</article>

		{% if single_post.related %}
			<aside class="lk-single-post__related" aria-label="{{ single_post.related_title }}">
				<h2 class="lk-single-post__related-title">{{ single_post.related_title }}</h2>
				<div class="lk-single-post__related-grid" role="list">
					{% for post in single_post.related %}
						<div class="lk-article-card-wrap" role="listitem">
							<article class="lk-article-card">
								<a class="lk-article-card__media" href="{{ post.url }}">
									{% if post.image %}
										<img src="{{ post.image }}" alt="{{ post.title }}" loading="lazy" width="600" height="173">
									{% endif %}
								</a>
								<div class="lk-article-card__body">
									<p class="lk-article-card__date">
										<svg class="lk-article-card__date-icon" viewBox="0 0 448 512" aria-hidden="true"><path fill="currentColor" d="M148 288h-40c-6.6 0-12-5.4-12-12v-40c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v40c0 6.6-5.4 12-12 12zm108-12v-40c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12v40c0 6.6 5.4 12 12 12h40c6.6 0 12-5.4 12-12zm96 0v-40c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12v40c0 6.6 5.4 12 12 12h40c6.6 0 12-5.4 12-12zm-96 96v-40c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12v40c0 6.6 5.4 12 12 12h40c6.6 0 12-5.4 12-12zm-96 0v-40c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12v40c0 6.6 5.4 12 12 12h40c6.6 0 12-5.4 12-12zm192 0v-40c0-6.6-5.4-12-12-12h-40c-6.6 0-12 5.4-12 12v40c0 6.6 5.4 12 12 12h40c6.6 0 12-5.4 12-12zm96-260v352c0 26.5-21.5 48-48 48H48c-26.5 0-48-21.5-48-48V112c0-26.5 21.5-48 48-48h48V12c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v52h128V12c0-6.6 5.4-12 12-12h40c6.6 0 12 5.4 12 12v52h48c26.5 0 48 21.5 48 48zm-48 346V160H48v298c0 3.3 2.7 6 6 6h340c3.3 0 6-2.7 6-6z"/></svg>
										<span>{{ post.date }}</span>
									</p>
									<h3 class="lk-article-card__title"><a href="{{ post.url }}">{{ post.title }}</a></h3>
									<a class="lk-article-card__more" href="{{ post.url }}">{{ single_post.more_label }}</a>
								</div>
							</article>
						</div>
					{% endfor %}
				</div>
			</aside>
		{% endif %}
	</div>
</div>
{% endif %}
{% endblock %}
