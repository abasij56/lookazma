{% extends "woo/base-light-product.twig" %}

{% block content %}
{% if about %}
<div class="lk-lpt lk-lpt-container lk-about-page">
	{% if about.breadcrumb_html %}
		<nav class="lk-lpt-breadcrumb" aria-label="breadcrumb">
			{{ about.breadcrumb_html|raw }}
		</nav>
	{% endif %}

	<section class="lk-about-intro" aria-labelledby="lk-about-title">
		<div class="lk-about-intro__copy">
			<h1 class="lk-about-intro__title" id="lk-about-title">{{ about.title }}</h1>
			{% if about.lead %}
				<p class="lk-about-intro__lead">{{ about.lead }}</p>
			{% endif %}
			{% if about.body %}
				<p class="lk-about-intro__body">{{ about.body }}</p>
			{% endif %}
		</div>
		{% if about.intro_image_url %}
			<figure class="lk-about-intro__media">
				<img src="{{ about.intro_image_url }}" alt="{{ about.intro_image_alt }}" width="540" height="540" loading="eager" decoding="async">
			</figure>
		{% endif %}
	</section>

	{% if about.features %}
		<section class="lk-about-features" aria-label="ویژگی‌ها">
			{% for item in about.features %}
				<article class="lk-about-feature">
					{% if item.image %}
						<img class="lk-about-feature__icon" src="{{ item.image }}" alt="" width="72" height="72" loading="lazy" decoding="async">
					{% endif %}
					<h2 class="lk-about-feature__title">{{ item.title }}</h2>
					<p class="lk-about-feature__text">{{ item.text }}</p>
				</article>
			{% endfor %}
		</section>
	{% endif %}

	{% if about.highlights %}
		<section class="lk-about-highlights" aria-label="مزایا">
			{% for item in about.highlights %}
				<article class="lk-about-highlight" data-lk-about-icon="{{ item.icon }}">
					<div class="lk-about-highlight__icon" aria-hidden="true">
						{% if item.icon == 'consult' %}
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" focusable="false"><path fill="currentColor" d="M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4zm0 2c-3.33 0-10 1.67-10 5v1h20v-1c0-3.33-6.67-5-10-5z"/></svg>
						{% else %}
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="28" height="28" focusable="false"><path fill="currentColor" d="M2 21h4V9H2v12zm19.6-9.8c.3-.5.4-1.1.2-1.7-.3-.8-1.1-1.3-2-1.3h-5.2l.8-3.8.1-.8c0-.4-.2-.8-.4-1.1L13.8 2 7.9 7.9C7.6 8.2 7.4 8.6 7.4 9v10c0 1.1.9 2 2 2h7.4c.8 0 1.5-.5 1.8-1.2l3.1-7.2c.2-.4.3-.8.3-1.2v-.2z"/></svg>
						{% endif %}
					</div>
					<div class="lk-about-highlight__body">
						<h2 class="lk-about-highlight__title">{{ item.title }}</h2>
						<p class="lk-about-highlight__text">{{ item.text }}</p>
					</div>
				</article>
			{% endfor %}
		</section>
	{% endif %}

	{% if about.faqs %}
		<section class="lk-about-faq" aria-labelledby="lk-about-faq-title">
			{% if about.faq_image_url %}
				<figure class="lk-about-faq__media">
					<img src="{{ about.faq_image_url }}" alt="{{ about.faq_image_alt }}" width="540" height="540" loading="lazy" decoding="async">
				</figure>
			{% endif %}
			<div class="lk-about-faq__panel">
				<h2 class="lk-about-faq__title" id="lk-about-faq-title">{{ about.faq_title }}</h2>
				{% if about.faq_subtitle %}
					<p class="lk-about-faq__subtitle">{{ about.faq_subtitle }}</p>
				{% endif %}
				<div class="lk-about-faq__list">
					{% for item in about.faqs %}
						<details class="lk-about-faq__item"{% if loop.first %} open{% endif %}>
							<summary class="lk-about-faq__question">{{ item.question }}</summary>
							<div class="lk-about-faq__answer">
								<p>{{ item.answer|nl2br|raw }}</p>
							</div>
						</details>
					{% endfor %}
				</div>
			</div>
		</section>
	{% endif %}
</div>
{% endif %}
{% endblock %}
