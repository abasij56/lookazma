{% extends "woo/base-light-product.twig" %}

{% block content %}
{% if contact %}
<div class="lk-lpt lk-lpt-container lk-contact-page">
	{% if contact.breadcrumb_html %}
		<nav class="lk-lpt-breadcrumb" aria-label="breadcrumb">
			{{ contact.breadcrumb_html|raw }}
		</nav>
	{% endif %}

	<header
		class="lk-contact-head{% if contact.banner_image_url %} lk-contact-head--banner{% endif %}"
		{% if contact.banner_image_url %}style="--lk-contact-banner-image: url('{{ contact.banner_image_url }}');"{% endif %}
	>
		<h1 class="lk-contact-head__title" id="lk-contact-title">{{ contact.title }}</h1>
	</header>

	<div class="lk-contact-layout">
		<div class="lk-contact-panel">
			{% if contact.intro %}
				<p class="lk-contact-intro">{{ contact.intro }}</p>
			{% endif %}

			<section class="lk-contact-channels" aria-label="راه‌های ارتباطی">
				{% for item in contact.channels %}
					<article class="lk-contact-channel" data-lk-contact-type="{{ item.type }}">
						<div class="lk-contact-channel__icon" aria-hidden="true">
							{% if item.type == 'email' %}
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="48" height="48" focusable="false"><path fill="currentColor" d="M6 10h36a2 2 0 0 1 2 2v24a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V12a2 2 0 0 1 2-2zm2 4 16 11L40 14H8zm32 22V16.5L25.2 28.8a1.5 1.5 0 0 1-1.7 0L8 16.5V36h32z"/></svg>
							{% elseif item.type == 'phone' %}
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="48" height="48" focusable="false"><path fill="currentColor" d="M15.2 8.5c1-.9 2.4-.7 3.3.2l3.4 3.4c.8.8.9 2 .3 2.9l-2.2 3.3c1.8 3.1 4.2 5.9 7.3 7.7l3.3-2.2c.9-.6 2.1-.5 2.9.3l3.4 3.4c.9.9 1.1 2.3.2 3.3l-2.6 2.9c-1 .9-2.4 1.2-3.7.9-6.8-1.8-12.5-6.3-16.2-12.5-.5-.9-.6-2-.1-2.9l2.9-3.3z"/></svg>
							{% else %}
								<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="48" height="48" focusable="false"><path fill="currentColor" d="M24 6c-6.63 0-12 5.37-12 12 0 8.28 12 22 12 22s12-13.72 12-22c0-6.63-5.37-12-12-12zm0 16.5A4.5 4.5 0 1 1 24 13a4.5 4.5 0 0 1 0 9z"/></svg>
							{% endif %}
						</div>
						<div class="lk-contact-channel__content">
							<h2 class="lk-contact-channel__label">{{ item.label }}</h2>
							{% if item.href %}
								<a class="lk-contact-channel__value" href="{{ item.href }}">{{ item.value }}</a>
							{% else %}
								<p class="lk-contact-channel__value lk-contact-channel__value--text">{{ item.value|nl2br|raw }}</p>
							{% endif %}
						</div>
					</article>
				{% endfor %}
			</section>

			{% if contact.social %}
				<section class="lk-contact-social" aria-label="شبکه‌های اجتماعی">
					{% if contact.social_title %}
						<h2 class="lk-contact-social__title">{{ contact.social_title }}</h2>
					{% endif %}
					<ul class="lk-contact-social__list">
						{% for item in contact.social %}
							<li>
								<a class="lk-contact-social__link lk-contact-social__link--{{ item.key }}" href="{{ item.url }}" target="_blank" rel="noopener noreferrer" aria-label="{{ item.label }}">
									{% if item.key == 'instagram' %}
										<svg aria-hidden="true" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/></svg>
									{% elseif item.key == 'linkedin' %}
										<svg aria-hidden="true" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M416 32H31.9C14.3 32 0 46.5 0 64.3v383.4C0 465.5 14.3 480 31.9 480H416c17.6 0 32-14.5 32-32.3V64.3c0-17.8-14.4-32.3-32-32.3zM135.4 416H69V202.2h66.5V416zm-33.2-243c-21.3 0-38.5-17.3-38.5-38.5S80.9 96 102.2 96c21.2 0 38.5 17.3 38.5 38.5 0 21.3-17.2 38.5-38.5 38.5zm282.1 243h-66.4V312c0-24.8-.5-56.7-34.5-56.7-34.6 0-39.9 27-39.9 54.9V416h-66.4V202.2h63.7v29.2h.9c8.9-16.8 30.6-34.5 62.9-34.5 67.2 0 79.7 44.3 79.7 101.9V416z"/></svg>
									{% elseif item.key == 'whatsapp' %}
										<svg aria-hidden="true" viewBox="0 0 448 512" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/></svg>
									{% elseif item.key == 'telegram' %}
										<svg aria-hidden="true" viewBox="0 0 496 512" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M248 8C111 8 0 119 0 256s111 248 248 248 248-111 248-248S385 8 248 8zm121.8 169.9l-40.7 191.8c-3 13.6-11.1 16.9-22.4 10.5l-62-45.7-29.9 28.8c-3.3 3.3-6.1 6.1-12.5 6.1l4.4-63.1 114.9-103.8c5-4.4-1.1-6.9-7.7-2.5l-142 89.4-61.2-19.1c-13.3-4.2-13.6-13.3 2.8-19.7l239.1-92.2c11.1-4 20.8 2.7 17.2 19.5z"/></svg>
									{% elseif item.key == 'x' %}
										<svg aria-hidden="true" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z"/></svg>
									{% elseif item.key == 'facebook' %}
										<svg aria-hidden="true" viewBox="0 0 512 512" xmlns="http://www.w3.org/2000/svg"><path fill="currentColor" d="M504 256C504 119 393 8 256 8S8 119 8 256c0 123.78 90.69 226.38 209.25 245V327.69h-63V256h63v-54.64c0-62.15 37-96.48 93.67-96.48 27.14 0 55.52 4.84 55.52 4.84v61h-31.28c-30.8 0-40.41 19.12-40.41 38.73V256h68.78l-11 71.69h-57.78V501C413.31 482.38 504 379.78 504 256z"/></svg>
									{% endif %}
								</a>
							</li>
						{% endfor %}
					</ul>
				</section>
			{% endif %}
		</div>

		{% if contact.hero_image_url %}
			<aside class="lk-contact-aside" aria-hidden="true">
				<img class="lk-contact-aside__img" src="{{ contact.hero_image_url }}" alt="" width="600" height="318" loading="lazy" decoding="async">
			</aside>
		{% endif %}
	</div>

	{% if contact.form_html %}
		<section class="lk-contact-form" aria-label="فرم تماس">
			<div class="lk-contact-form__body">
				{{ contact.form_html|raw }}
			</div>
		</section>
	{% endif %}
</div>
{% endif %}
{% endblock %}
