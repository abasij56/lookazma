<!doctype html>
<!-- LK-LIGHT-TWIG-RENDERED -->
<html {{ html_language_attributes|raw }}>
<head>
	<meta charset="{{ site.charset }}">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap" rel="stylesheet">
	{% if light_css_url %}
		<link rel="stylesheet" href="{{ light_css_url }}?v={{ light_css_ver }}">
	{% endif %}
	{% if light_css_inline %}
		<style id="lk-spl-inline">{{ light_css_inline|raw }}</style>
	{% endif %}
	{{ function('wp_head') }}
</head>
<body class="{{ body_class }}">
{{ function('wp_body_open') }}

<header class="lz-site-header">
	<div class="lz-site-header__top">
		<a class="lz-site-header__logo" href="{{ site.url }}">
			{% if site_chrome.logo_url %}
				<img src="{{ site_chrome.logo_url }}" width="248" height="36" alt="{{ site.name }}">
			{% else %}
				<strong>{{ site.name }}</strong>
			{% endif %}
		</a>

		<div class="lz-search lz-search--desktop">
			<form action="{{ site.url }}/" method="get" role="search">
				<label class="screen-reader-text" for="lz-search-desktop">جستجوی محصولات</label>
				<input id="lz-search-desktop" type="search" name="s" value="" placeholder="از طریق نام محصول یا Cas No محصول مورد نظر خود را جستجو کنید" autocomplete="off">
				<input type="hidden" name="post_type" value="product">
				<button type="submit" aria-label="جستجو">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M12.5 11h-.8l-.3-.3a6 6 0 1 0-.7.7l.3.3v.8l5 5 1.5-1.5-5-5zm-5.5 0a4 4 0 1 1 0-8 4 4 0 0 1 0 8z"/></svg>
				</button>
			</form>
		</div>

		<a class="lz-cart-btn" href="{{ site_chrome.cart_url }}" aria-label="سبد خرید">
			{% if site_chrome.cart_total %}
				<span class="lz-cart-btn__price">{{ site_chrome.cart_total|raw }}</span>
			{% endif %}
			<span class="lz-cart-btn__icon">
				<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M18 6A6 6 0 0 0 6 6H0v15a3 3 0 0 0 3 3h11v-2H3a1 1 0 0 1-1-1V8h4v2h2V8h8v2h2V8h4v6h2V6zm-10 0a4 4 0 0 1 8 0z"/><path d="M21 16h-2v3h-3v2h3v3h2v-3h3v-2h-3z"/></svg>
				<span class="lz-cart-btn__count">{{ site_chrome.cart_count }}</span>
			</span>
		</a>
	</div>

	<div class="lz-search-mobile">
		<div class="lz-search">
			<form action="{{ site.url }}/" method="get" role="search">
				<label class="screen-reader-text" for="lz-search-mobile">جستجوی محصولات</label>
				<input id="lz-search-mobile" type="search" name="s" value="" placeholder="جستجوی نام محصول یا Cas No" autocomplete="off">
				<input type="hidden" name="post_type" value="product">
				<button type="submit" aria-label="جستجو">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M12.5 11h-.8l-.3-.3a6 6 0 1 0-.7.7l.3.3v.8l5 5 1.5-1.5-5-5zm-5.5 0a4 4 0 1 1 0-8 4 4 0 0 1 0 8z"/></svg>
				</button>
			</form>
		</div>
	</div>

	<div class="lz-site-header__bottom">
		<nav class="lz-nav" aria-label="منوی اصلی">
			{% for item in site_chrome.nav %}
				<a href="{{ item.url }}">{{ item.label }}</a>
			{% endfor %}
		</nav>
		<div class="lz-phones">
			<a href="tel:{{ site_chrome.phone_office }}">{{ site_chrome.phone_office }}</a>
			<a href="tel:{{ site_chrome.phone_mobile }}">{{ site_chrome.phone_mobile }}</a>
		</div>
	</div>
</header>

<main class="lk-main">
	{% block content %}{% endblock %}
</main>

<footer class="lz-site-footer">
	<div class="lz-site-footer__main">
		<div>
			<a class="lz-site-footer__logo" href="{{ site.url }}">
				{% if site_chrome.footer_logo_url %}
					<img src="{{ site_chrome.footer_logo_url }}" width="248" height="36" alt="{{ site.name }}">
				{% else %}
					<strong>{{ site.name }}</strong>
				{% endif %}
			</a>
			<p class="lz-site-footer__about">{{ site_chrome.footer_about }}</p>
			{% if site_chrome.instagram_url %}
				<div class="lz-site-footer__social">
					<a href="{{ site_chrome.instagram_url }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">Instagram</a>
				</div>
			{% endif %}
		</div>

		<div>
			<h3>دسترسی سریع</h3>
			<ul class="lz-site-footer__links">
				{% for item in site_chrome.footer_links %}
					<li><a href="{{ item.url }}">{{ item.label }}</a></li>
				{% endfor %}
			</ul>
		</div>

		<div>
			<h3>ارتباط با ما</h3>
			<ul class="lz-site-footer__contacts">
				<li><a href="tel:{{ site_chrome.phone_office }}">{{ site_chrome.phone_office }}</a></li>
				<li><a href="tel:{{ site_chrome.phone_mobile }}">{{ site_chrome.phone_mobile }}</a></li>
				<li><a href="mailto:{{ site_chrome.email }}">{{ site_chrome.email }}</a></li>
				<li>{{ site_chrome.address }}</li>
				<li>{{ site_chrome.hours }}</li>
			</ul>
		</div>

		<div class="lz-site-footer__trust">
			{% if site_chrome.enamad_url %}
				<a target="_blank" rel="noopener noreferrer" href="{{ site_chrome.enamad_url }}">
					<img src="{{ site_chrome.enamad_img }}" alt="نماد اعتماد الکترونیکی" width="120" height="120">
				</a>
			{% endif %}
			<p>«در صورت فعال بودن VPN، نماد اعتماد نمایش داده نمی‌شود»</p>
		</div>
	</div>

	<div class="lz-site-footer__bar">
		<span>کلیه حقوق طراحی این سایت برای {{ site.name }} محفوظ است.</span>
		<span>{{ site_chrome.designed_by }}</span>
	</div>
</footer>

{{ function('wp_footer') }}
</body>
</html>
